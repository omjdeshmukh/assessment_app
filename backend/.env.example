# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection URI (Set your MongoDB Atlas or Local URI)
MONGODB_URI=mongodb://localhost:27017/gemini_assessment

# JWT Secret for Admin Session Tokens
JWT_SECRET=your_jwt_secret_key_here

# Server-Side Admin Setup Secret (Used for one-time admin provisioning via POST /api/admin/setup)
ADMIN_SETUP_SECRET=your_admin_setup_secret_here

# Allowed upload file size in bytes (24MB default)
MAX_FILE_SIZE_BYTES=25165824
